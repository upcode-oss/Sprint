# Copy to .env and replace every value marked CHANGE_ME in production.
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_generate_a_long_random_value
PUBLIC_APP_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

# The initial database is used until the setup wizard selects a database.
# SQLite: sqlite:////data/sprint.db
# PostgreSQL: postgresql+psycopg://sprint:password@postgres:5432/sprint
# MariaDB/MySQL: mysql+pymysql://sprint:password@mariadb:3306/sprint?charset=utf8mb4
DATABASE_URL=sqlite:////data/sprint.db
INSTALLATION_CONFIG_PATH=/data/installation.json

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5/minute
AVATAR_STORAGE_PATH=/data/avatars
AVATAR_MAX_BYTES=5242880
PRESENCE_HEARTBEAT_INTERVAL=60
PRESENCE_AWAY_AFTER=300
PRESENCE_OFFLINE_AFTER=900

# Used by the optional PostgreSQL compose profile.
POSTGRES_DB=sprint
POSTGRES_USER=sprint
POSTGRES_PASSWORD=CHANGE_ME_database_password

# Browser requests use the Next.js same-origin API proxy.
BACKEND_INTERNAL_URL=http://backend:8000
